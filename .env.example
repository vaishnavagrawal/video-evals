# vreview environment configuration

# Postgres Database (use host port 55433 for local dev stack)
VREVIEW_DATABASE_URL=postgresql+psycopg://vreview:vreview@localhost:55433/vreview

# Blob storage ("r2" or "local")
VREVIEW_STORE=r2
VREVIEW_LOCAL_STORE_ROOT=var/blobs
VREVIEW_R2_ENDPOINT_URL=http://localhost:59000
VREVIEW_R2_PUBLIC_ENDPOINT_URL=http://localhost:59000
VREVIEW_R2_ACCESS_KEY_ID=minioadmin
VREVIEW_R2_SECRET_ACCESS_KEY=minioadmin
VREVIEW_R2_BUCKET=vreview
VREVIEW_PRESIGN_TTL_SECONDS=900
# Largest file POST /v1/uploads accepts, in bytes (default 2 GiB); larger declared sizes get 413
VREVIEW_MAX_UPLOAD_BYTES=2147483648

# Worker scratch storage
VREVIEW_SCRATCH_DIR=/tmp/vreview

# Authentication (better-auth JWKS, hosted by the web app; iss and aud are its base URL)
VREVIEW_AUTH_JWKS_URL=http://localhost:53000/api/auth/jwks
VREVIEW_AUTH_ISSUER=http://localhost:53000
VREVIEW_AUTH_AUDIENCE=http://localhost:53000

# Outgoing webhooks
VREVIEW_WEBHOOK_SECRET=replace-with-webhook-secret
VREVIEW_PUBLIC_BASE_URL=http://localhost:58000
# Webhook URLs must be https and resolve to public addresses. 1 also allows http:// (local development only;
# private, loopback and link-local targets stay blocked either way)
VREVIEW_WEBHOOK_ALLOW_HTTP=0

# Hatchet Orchestration Client
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_HOST_PORT=localhost:57077
HATCHET_CLIENT_TLS_STRATEGY=none

# Browser origins allowed to call the API (comma-separated)
VREVIEW_CORS_ORIGINS=http://localhost:53000

# ---- Models -------------------------------------------------------------------------------------------
# Every model is a reference "provider:model" (a bare "model" uses LLM_DEFAULT_PROVIDER, default "gateway").
# Providers are OpenAI-compatible endpoints configured by env; see src/dubeval/providers.py.
# Built-in presets: meta, openai, openrouter, fireworks, groq, gateway. Any other name works too:
#   LLM_PROVIDER_<NAME>_BASE_URL=...   LLM_PROVIDER_<NAME>_API_KEY=... (or _API_KEY_ENV=VAR_NAME)
#   LLM_PROVIDER_<NAME>_VIDEO=video_url|frames|none   LLM_PROVIDER_<NAME>_TIMEOUT=150

# Meta Model API (https://api.meta.ai/v1): Muse Spark reads video + audio through `video_url` parts.
META_API_KEY=

# "gateway": any OpenAI-compatible router (OmniRoute, LiteLLM, ...). Legacy names still work.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
# LLM_DEFAULT_PROVIDER=gateway

# Model roles (comma-separated fallback lists). Briefs can override them per review via `options`.
# Text judge for dub meaning/tone. Empty = built-in default (gateway gemini-flash, auto/best-fast).
VREVIEW_JUDGE_MODELS=meta:muse-spark-1.3,gateway:gemini-flash
# fallback = first model that answers; ensemble = every model judges, answers merged (steadier, N x calls)
VREVIEW_JUDGE_MODE=ensemble
# Writes review-thread comments and the summary. Empty = rule-based text only.
VREVIEW_TRIAGE_LLM_MODELS=meta:muse-spark-1.3,gateway:gemini-flash
# Multimodal second opinion over located windows (video + audio). Empty = evaluator not run.
VREVIEW_AV_JUDGE_MODELS=meta:muse-spark-1.3
# Cloud ASR (OpenAI-compatible /audio/transcriptions with word timestamps). Empty = built-in default
# (gateway groq/whisper-large-v3); "none" = local faster-whisper only.
VREVIEW_ASR_MODEL=
