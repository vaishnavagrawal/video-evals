# Copy to .env.local and fill in. .env.local is gitignored.

# better-auth: 32+ random bytes, e.g. `openssl rand -base64 32`. Also encrypts the JWKS private keys.
BETTER_AUTH_SECRET=
# Public origin of this app. Also the JWT issuer and audience the API checks
# (VREVIEW_AUTH_ISSUER / VREVIEW_AUTH_AUDIENCE) and the base of the JWKS URL
# (VREVIEW_AUTH_JWKS_URL=http://localhost:53000/api/auth/jwks).
BETTER_AUTH_URL=http://localhost:53000
# better-auth database (users, sessions, jwks). Create it once:
#   docker exec vreview-postgres-1 psql -U vreview -d postgres -c "CREATE DATABASE vreview_auth OWNER vreview"
DATABASE_URL=postgres://vreview:vreview@localhost:55433/vreview_auth

# vreview FastAPI base URL (the browser calls it directly with Authorization: Bearer <jwt>).
NEXT_PUBLIC_VREVIEW_API_URL=http://localhost:58000
# 1 = use the in-browser mock API built from a fixture report instead of the real API. Auth stays real.
NEXT_PUBLIC_VREVIEW_MOCK=0
# Mock mode only: local video files streamed by /api/mock-media/{original,candidate}.
VREVIEW_MOCK_ORIGINAL_PATH=
VREVIEW_MOCK_CANDIDATE_PATH=
